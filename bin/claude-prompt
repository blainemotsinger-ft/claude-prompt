#!/usr/bin/perl

# Claude Code statusline in the style of a shell prompt:
#
#   ~/git/repo (branch *) [model:Opus 5.5 | context:10% | cache:98% | cost:$1.97 | time:1h 2m]
#
# Claude Code runs this on each redraw and sends the session's details as JSON on STDIN.
#
# The layout comes from ~/.config/claude-prompt/config.json (or $XDG_CONFIG_HOME, or the
# file named in CLAUDE_PROMPT_CONFIG). Without one, the default below is used. See README.md.

use strict;
use warnings;

use Encode      ();
use JSON::PP    ();
use List::Util  ();
use POSIX       ();
use Time::HiRes ();

my @GIT_PROMPT_SCRIPTS = ( '/usr/lib/git-core/git-sh-prompt', '/usr/share/git-core/contrib/completion/git-prompt.sh', '/etc/bash_completion.d/git-prompt', '/opt/homebrew/etc/bash_completion.d/git-prompt.sh', '/usr/local/etc/bash_completion.d/git-prompt.sh', );

# Claude Code drops lines that are empty or only whitespace, so padding lines
# hold a Braille blank (U+2800): it draws nothing but is not whitespace
my $BLANK = "\x{2800}";

# Seconds to wait for git before leaving the branch out
my $GIT_TIMEOUT = 1;

# Seconds a command from the config gets to finish, unless it sets its own timeout
my $COMMAND_TIMEOUT = 1;

# Bytes of output to keep from git or a command; anything after this is read and thrown away
my $OUTPUT_LIMIT = 4096;

# Each section returns its text without the label, or nothing to leave it out
my %SECTIONS = (
    dir     => sub { short_dir( $_[0]{dir} ) },
    git     => sub { git_prompt( $_[0]{dir}, $_[0]{config}{git} ) },
    model   => sub { string( field( $_[0]{input}, qw(model display_name) ) ) },
    context => sub { percent( number( field( $_[0]{input}, qw(context_window used_percentage) ) ) ) },
    cache   => sub { percent( cache_hit_rate( $_[0]{input} ) ) },
    cost    => sub { dollars( number( field( $_[0]{input}, qw(cost total_cost_usd) ) ) ) },
    time    => sub { duration( number( field( $_[0]{input}, qw(cost total_duration_ms) ) ) ) },
);

sub default_config {
    return {
        sections => [
            'dir', 'git',
            {   before    => '[',
                sections  => [qw(model context cache cost time)],
                separator => ' | ',
                after     => ']',
            },
        ],
        separator => ' ',
        labels    => {
            model   => 'model:',
            context => 'context:',
            cache   => 'cache:',
            cost    => 'cost:',
            time    => 'time:',
        },
        git => {
            format => '(%s)',
            env    => {},
        },
        padding  => 1,
        commands => {},
    };
}

binmode STDOUT, ':encoding(UTF-8)';

my ( $input, $raw_input ) = read_input();
my $dir = string( field( $input, qw(workspace current_dir) ) ) // string( field( $input, 'cwd' ) );

my $config = eval { load_config() };
if ( !$config ) {
    print 'claude-prompt: ', $@;
    print "$BLANK\n";
    exit;
}

my $line = render_items( $config->{sections}, $config->{separator}, { input => $input, raw_input => $raw_input, config => $config, dir => $dir } );

print $line // '', "\n";
print "$BLANK\n" for 1 .. $config->{padding};

sub read_input {
    my $json = do { local $/; <STDIN> }
        // '';
    my $data = eval { JSON::PP->new->utf8->decode($json) };

    # The parsed input, and the bytes as sent, which are passed on to commands
    return ( ref $data eq 'HASH' ? $data : {} ), $json;
}

sub config_path {
    return Encode::decode( 'UTF-8', $ENV{CLAUDE_PROMPT_CONFIG} ) if length( $ENV{CLAUDE_PROMPT_CONFIG} // '' );

    my $base = length( $ENV{XDG_CONFIG_HOME} // '' ) ? $ENV{XDG_CONFIG_HOME} : ( $ENV{HOME} // '' ) . '/.config';
    return Encode::decode( 'UTF-8', "$base/claude-prompt/config.json" );
}

# Reads the config file over the defaults, dying with a message for the statusline if it's wrong
sub load_config {
    my $config = default_config();
    my $path   = config_path();
    my $name   = short_dir($path);

    my $path_bytes = Encode::encode( 'UTF-8', $path );
    return $config unless -e $path_bytes;

    open my $fh, '<:raw', $path_bytes or die "$name: can't read it: $!\n";
    my $json = do { local $/; <$fh> }
        // '';
    close $fh;

    my $user = eval { JSON::PP->new->utf8->relaxed->decode($json) };
    if ( !defined $user ) {
        my $error = $@;
        $error =~ s/,? at \S+ line \d+\.?\s*$//;
        die "$name: not valid JSON: $error\n";
    }
    die "$name: should hold a JSON object, like {\"padding\": 1}\n" unless ref $user eq 'HASH';

    for my $key ( sort keys %$user ) {
        die "$name: unknown setting \"$key\"\n" unless exists $config->{$key};

        if ( ref $config->{$key} eq 'HASH' && ref $user->{$key} eq 'HASH' ) {
            $config->{$key} = { %{ $config->{$key} }, %{ $user->{$key} } };
        }
        else {
            $config->{$key} = $user->{$key};
        }
    }

    my $error = check_config($config);
    die "$name: $error\n" if $error;

    return $config;
}

# Returns a description of the first problem found, or nothing if the config is usable
sub check_config {
    my ($config) = @_;

    my $error = check_commands( $config->{commands} );
    return $error if $error;

    $error = check_sections( $config->{sections}, 'sections', $config );
    return $error if $error;

    return '"separator" should be text' unless is_text( $config->{separator} );

    return '"labels" should be an object, like {"model": "model:"}' unless ref $config->{labels} eq 'HASH';
    for my $name ( sort keys %{ $config->{labels} } ) {
        return "unknown section \"$name\" in \"labels\"" unless is_section( $config, $name );
        return "label for \"$name\" should be text"      unless is_text( $config->{labels}{$name} );
    }

    my $git = $config->{git};
    return '"git" should be an object, like {"format": "(%s)"}' unless ref $git eq 'HASH';
    for my $key ( sort keys %$git ) {
        return "unknown setting \"$key\" in \"git\"" unless $key =~ /^(?:format|script|env)$/;
    }
    return '"git.format" should be text' if !is_text( $git->{format} );
    return '"git.script" should be text' if exists $git->{script} && !is_text( $git->{script} );
    return '"git.env" should be an object, like {"GIT_PS1_SHOWDIRTYSTATE": "1"}' unless ref $git->{env} eq 'HASH';
    for my $name ( sort keys %{ $git->{env} } ) {
        return "\"git.env\" value for \"$name\" should be text" unless is_text( $git->{env}{$name} );
    }

    return '"padding" should be a whole number, like 1' unless defined $config->{padding} && !ref $config->{padding} && $config->{padding} =~ /^\d+$/;

    return;
}

sub check_commands {
    my ($commands) = @_;

    return '"commands" should be an object, like {"k8s": {"run": "kubectl config current-context"}}' unless ref $commands eq 'HASH';

    for my $name ( sort keys %$commands ) {
        return 'a command in "commands" has an empty name' unless length $name;
        return "command \"$name\" has the same name as a built-in section" if $SECTIONS{$name};

        my $command = $commands->{$name};
        return "command \"$name\" should be an object, like {\"run\": \"date +%H:%M\"}" unless ref $command eq 'HASH';
        for my $key ( sort keys %$command ) {
            return "unknown setting \"$key\" in command \"$name\"" unless $key =~ /^(?:run|timeout)$/;
        }
        return "command \"$name\" needs \"run\", the command to run, like \"date +%H:%M\"" unless is_text( $command->{run} ) && length $command->{run};

        my $timeout = number( $command->{timeout} );
        return "\"timeout\" in command \"$name\" should be a number of seconds above 0, like 1" if exists $command->{timeout} && !( defined $timeout && $timeout > 0 );
    }

    return;
}

sub check_sections {
    my ( $sections, $where, $config ) = @_;

    return "\"$where\" should be a list, like [\"dir\", \"git\"]" unless ref $sections eq 'ARRAY';

    for my $item (@$sections) {
        if ( ref $item eq 'HASH' ) {
            for my $key ( sort keys %$item ) {
                return "unknown setting \"$key\" in a group in \"$where\"" unless $key =~ /^(?:sections|separator|before|after)$/;
            }
            for my $key (qw(separator before after)) {
                return "\"$key\" in a group in \"$where\" should be text" if exists $item->{$key} && !is_text( $item->{$key} );
            }
            my $error = check_sections( $item->{sections}, "$where.sections", $config );
            return $error if $error;
        }
        elsif ( is_text($item) ) {
            return "unknown section \"$item\" in \"$where\" (known: " . join( ', ', sort( keys %SECTIONS, keys %{ $config->{commands} } ) ) . ')' unless is_section( $config, $item );
        }
        else {
            return "each item in \"$where\" should be a section name or a group";
        }
    }

    return;
}

# True for a built-in section or a command from the config
sub is_section {
    my ( $config, $name ) = @_;

    return $SECTIONS{$name} || $config->{commands}{$name};
}

sub is_text {
    my ($value) = @_;

    return defined $value && !ref $value;
}

# Joins the items that have something to show, or returns nothing if none do
sub render_items {
    my ( $items, $separator, $context ) = @_;

    my @parts = grep {defined} map { render_item( $_, $context ) } @$items;

    return @parts ? join( $separator, @parts ) : undef;
}

sub render_item {
    my ( $item, $context ) = @_;

    if ( ref $item eq 'HASH' ) {
        my $inner = render_items( $item->{sections}, $item->{separator} // ' ', $context );
        return unless defined $inner;
        return ( $item->{before} // '' ) . $inner . ( $item->{after} // '' );
    }

    my $value = $SECTIONS{$item} ? $SECTIONS{$item}->($context) : run_command( $context->{config}{commands}{$item}, $context );
    return unless defined $value && length $value;

    return ( $context->{config}{labels}{$item} // '' ) . $value;
}

# Walks nested hashes, returning undef if any step is missing or not a hash
sub field {
    my ( $data, @path ) = @_;

    for my $key (@path) {
        return unless ref $data eq 'HASH';
        $data = $data->{$key};
    }

    return $data;
}

sub string {
    my ($value) = @_;

    return defined $value && !ref $value && length $value ? $value : undef;
}

sub number {
    my ($value) = @_;

    return unless defined $value && !ref $value;
    return $value =~ /^-?(?:\d+\.?\d*|\.\d+)(?:[eE][-+]?\d+)?$/ ? $value : undef;
}

# Rounds half up, so 12.5 becomes 13
sub round {
    my ($value) = @_;

    return POSIX::floor( $value + 0.5 );
}

sub percent {
    my ($value) = @_;

    return defined $value ? round($value) . '%' : undef;
}

sub dollars {
    my ($value) = @_;

    return defined $value ? sprintf( '$%.2f', $value ) : undef;
}

sub short_dir {
    my ($dir) = @_;

    return unless defined $dir;

    my $home = Encode::decode( 'UTF-8', $ENV{HOME} // '' );
    $home =~ s{/+$}{};

    return $dir                               if $home eq '';
    return '~'                                if $dir eq $home;
    return '~' . substr( $dir, length $home ) if index( $dir, "$home/" ) == 0;
    return $dir;
}

sub git_prompt {
    my ( $dir, $git ) = @_;

    return unless defined $dir && -d Encode::encode( 'UTF-8', $dir );

    my $script = $git->{script} // List::Util::first { -r $_ } @GIT_PROMPT_SCRIPTS;
    return unless defined $script && -r $script;

    local $ENV{GIT_PS1_SHOWDIRTYSTATE} = $ENV{GIT_PS1_SHOWDIRTYSTATE} // 1;
    local @ENV{ keys %{ $git->{env} } } = map { Encode::encode( 'UTF-8', $_ ) } values %{ $git->{env} };

    # Don't take git's index lock just to draw the prompt
    local $ENV{GIT_OPTIONAL_LOCKS} = $ENV{GIT_OPTIONAL_LOCKS} // 0;

    my ($out) = run_program( [ 'bash', '-c', '. "$1" && __git_ps1 "$2"', 'claude-prompt', $script, Encode::encode( 'UTF-8', $git->{format} ) ], '', $dir, $GIT_TIMEOUT );
    return unless defined $out;

    $out = Encode::decode( 'UTF-8', $out );
    $out =~ s/^\s+|\s+$//g;

    return length $out ? $out : undef;
}

# Runs a command from the config with the session's JSON on STDIN, returning the first
# line it prints, or nothing if it prints nothing, fails, or runs past its time limit
sub run_command {
    my ( $command, $context ) = @_;

    my ( $output, $status ) = run_program( [ '/bin/sh', '-c', Encode::encode( 'UTF-8', $command->{run} ) ], $context->{raw_input}, $context->{dir}, $command->{timeout} // $COMMAND_TIMEOUT );
    return unless defined $output && $status == 0;

    my ($line) = split /\n/, $output;
    return unless defined $line;

    $line = Encode::decode( 'UTF-8', $line );
    $line =~ s/^\s+|\s+$//g;

    return length $line ? $line : undef;
}

# Runs a program with $input on STDIN, from $dir when that's a folder, returning the start of
# what it prints (up to $OUTPUT_LIMIT bytes) and its exit status. Returns nothing if it's still
# running after $timeout seconds, and stops it along with everything it started.
sub run_program {
    my ( $command, $input, $dir, $timeout ) = @_;

    pipe( my $stdin_read,  my $stdin_write )  or return;
    pipe( my $stdout_read, my $stdout_write ) or return;

    my $pid = fork // return;
    if ( $pid == 0 ) {

        # Its own process group, so a timeout can stop everything the program started
        setpgrp( 0, 0 );

        open STDIN,  '<&', $stdin_read   or POSIX::_exit(1);
        open STDOUT, '>&', $stdout_write or POSIX::_exit(1);
        open STDERR, '>',  '/dev/null';
        close $_ for $stdin_read, $stdin_write, $stdout_read, $stdout_write;

        # Run from Claude Code's folder when there is one, otherwise from wherever this was started
        chdir Encode::encode( 'UTF-8', $dir ) if defined $dir;

        { exec { $command->[0] } @$command };
        POSIX::_exit(127);
    }

    # Set in the parent as well, so the group exists before any timeout tries to stop it
    setpgrp( $pid, $pid );
    close $stdin_read;
    close $stdout_write;

    # A program that exits without reading its input shouldn't take this script down with it
    local $SIG{PIPE} = 'IGNORE';

    my ( $output, $status ) = ('');
    my $finished = eval {
        local $SIG{ALRM} = sub { die "timeout\n" };
        Time::HiRes::alarm($timeout);

        print {$stdin_write} $input;
        close $stdin_write;

        # Read in pieces, keeping only the start, so a program that prints without stopping
        # can't fill memory and the time limit gets checked between pieces. Reading to the
        # end, rather than stopping early, lets the program finish normally.
        while ( sysread $stdout_read, my $piece, 65_536 ) {
            $output .= $piece if length $output < $OUTPUT_LIMIT;
        }
        close $stdout_read;

        waitpid $pid, 0;
        $status = $?;

        Time::HiRes::alarm(0);
        1;
    };
    Time::HiRes::alarm(0);

    if ( !$finished ) {
        kill 'KILL', -$pid;
        waitpid $pid, 0;
        return;
    }

    return ( substr( $output, 0, $OUTPUT_LIMIT ), $status );
}

# Uses Claude Code's hit ratio for the whole session when it sends one,
# otherwise works it out from the last request's token counts
sub cache_hit_rate {
    my ($input) = @_;

    my $ratio = number( field( $input, qw(prompt_cache hit_ratio) ) );
    return $ratio * 100 if defined $ratio;

    my $usage = field( $input, qw(context_window current_usage) );
    my ( $read, $created, $uncached ) = map { number( field( $usage, $_ ) ) // 0 } qw(cache_read_input_tokens cache_creation_input_tokens input_tokens);

    my $total = $read + $created + $uncached;
    return unless $total > 0;

    return $read / $total * 100;
}

sub duration {
    my ($ms) = @_;

    return unless defined $ms;

    my $seconds = int( $ms / 1000 );
    my $minutes = int( $seconds / 60 );
    my $hours   = int( $minutes / 60 );

    return $hours . 'h' .   ( $minutes % 60 ? ' ' . ( $minutes % 60 ) . 'm' : '' ) if $hours;
    return $minutes . 'm' . ( $seconds % 60 ? ' ' . ( $seconds % 60 ) . 's' : '' ) if $minutes;
    return $seconds . 's';
}
